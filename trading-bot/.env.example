# ============================================================
#  TGC Trading Bot - configuration
#  Copy this file to ".env" and fill in your values.
#  NEVER commit your real .env file.
# ============================================================

# --- Exchange ---
# Supported out of the box: binance, bybit, bingx (and 100+ via ccxt ids)
EXCHANGE=binance

# API credentials. For SAFETY, create keys with TRADE permission only.
# DO NOT enable withdrawal permission on keys used by a bot.
API_KEY=
API_SECRET=
# Some exchanges (e.g. some bingx/okx endpoints) need a passphrase:
API_PASSWORD=

# Use the exchange testnet/sandbox if it supports one (recommended first).
USE_TESTNET=true

# --- Trading mode ---
# paper  = simulate fills against live market data (DEFAULT, no real money)
# live   = place REAL orders with REAL money
MODE=paper

# Starting balance for paper mode (quote currency, e.g. USDT)
PAPER_BALANCE=1000

# --- Market & strategy ---
SYMBOL=BTC/USDT
TIMEFRAME=1m
STRATEGY=scalping

# How often to evaluate the market, in seconds
POLL_INTERVAL_SECONDS=15

# --- Risk management ---
# Fraction of account equity risked per trade (0.01 = 1%)
RISK_PER_TRADE=0.01
# Stop-loss distance as a fraction of entry price (0.005 = 0.5%)
STOP_LOSS_PCT=0.005
# Take-profit distance as a fraction of entry price (0.01 = 1%)
TAKE_PROFIT_PCT=0.01
# Max number of open positions at once
MAX_OPEN_POSITIONS=1
# Stop trading for the day if equity drops this fraction from the day's start
MAX_DAILY_DRAWDOWN=0.05
# Taker fee fraction used by the paper engine (0.001 = 0.1%)
FEE_RATE=0.001

# --- Telegram control (phone) ---
# Create a bot with @BotFather, paste its token here. Leave blank to disable.
TELEGRAM_TOKEN=
# Your chat id. Leave blank first; message the bot once and it replies with it,
# then paste it here and restart. Only this chat can control the bot.
TELEGRAM_CHAT_ID=

# --- Telegram Mini App dashboard (optional) ---
# Set true to run the Mini App web server. Requires a PUBLIC https URL
# (e.g. via cloudflared/ngrok or a host) registered in @BotFather.
MINIAPP_ENABLED=false
MINIAPP_PORT=8080
MINIAPP_PUBLIC_URL=
